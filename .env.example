# Copy this file to .env and fill in your own values.  NEVER commit .env.

# YouTube Data API v3 key (Google Cloud Console → Credentials → API key,
# restricted to "YouTube Data API v3")
YOUTUBE_API_KEY=

# Your channel id (YouTube Studio → Settings → Channel → Advanced settings), starts with UC
YOUTUBE_CHANNEL_ID=

# Optional — only needed for the "Last 30 days" analytics section.
# OAuth client (Web application) + refresh token from OAuth Playground with scopes:
#   https://www.googleapis.com/auth/youtube.readonly
#   https://www.googleapis.com/auth/yt-analytics.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional
# PORT=3000
# MAX_VIDEOS=1000
